# Copy to .env for local use. Never commit .env. Generate unique random values locally.
JWT_SECRET=replace_with_a_unique_random_secret_at_least_32_characters
WEBHOOK_SECRET=replace_with_a_different_random_secret_at_least_32_characters
AUDIT_URL=http://127.0.0.1:9000/webhook
DEMO_EMPLOYEE_PASSWORD=replace_with_a_local_demo_password
DEMO_AUDITOR_PASSWORD=replace_with_a_local_demo_password
DEMO_ADMIN_PASSWORD=replace_with_a_local_demo_password
